# Supabase -> Project Settings -> API (public values, safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Supabase -> Project Settings -> API Keys -> Secret key (sb_secret_…),
# or the legacy service_role key. Used only to record Discord membership checks.
# Never add a NEXT_PUBLIC_ prefix. On Vercel, mark it "Sensitive".
SUPABASE_SECRET_KEY=

# The BGDC Discord server's ID (Discord: Developer Mode on, right-click the server, Copy Server ID)
DISCORD_GUILD_ID=

# Optional: invite link shown to players who aren't in the server yet
NEXT_PUBLIC_DISCORD_INVITE_URL=
